---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Insurances from '../../components/sections/Insurances.astro';
import WhyChooseUs from '../../components/sections/WhyChooseUs.astro';
import Reveal from '../../components/islands/motion/Reveal';
import { services } from '../../data/services';

const groups = [
  { id: 'weight-loss', eyebrow: 'Weight loss surgery', title: 'Lasting weight loss, with a team beside you.', text: 'Three proven operations. Your surgeon will help you pick the one that fits your health and goals.', items: services.filter((s) => s.kicker.toLowerCase().includes('weight')) },
  { id: 'general', eyebrow: 'General surgery', title: 'Relief from problems you should not have to put up with.', text: 'Hernias, gallbladder trouble and stubborn acid reflux can often be fixed with small incisions.', items: services.filter((s) => s.kicker === 'General surgery') },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.centralcaliforniasurgery.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services' },
  ] },
];
---
<PageLayout
  title="Surgery Services in Modesto, CA"
  description="Gastric sleeve, gastric bypass, duodenal switch, hernia repair, gallbladder surgery and acid reflux surgery in Modesto, CA. Call (209) 248-7168."
  schema={schema}
  bare
>
  <PageHero
    title="Surgery Services in Modesto, CA"
    eyebrow="Our services"
    lede="Weight loss surgery and general surgery from board-certified surgeons. Pick a service to see how it works, who it helps and what recovery looks like."
    image="/images/stock/ds-surgical-team.jpg"
    imageAlt="A surgical team working together in an operating room"
    position="50% 40%"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
    areaNote="Patients are welcome from across Modesto, Ceres, Turlock, Manteca, Stockton, Fresno and the greater Central Valley."
  />

  {groups.map((g, gi) => (
    <section id={g.id} class={`${gi % 2 === 0 ? 'wash-light' : 'wash-mist'} relative overflow-hidden py-20 md:py-24`} aria-labelledby={`${g.id}-title`}>
      <div class="relative mx-auto max-w-7xl px-6">
        <SectionHead id={`${g.id}-title`} eyebrow={g.eyebrow} title={g.title} text={g.text} />
        <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((s, n) => (
            <Reveal as="li" client:visible delay={n * 0.08}>
              <a href={`/services/${s.slug}`} class="card-hover group flex h-full flex-col overflow-hidden border border-line bg-white p-3">
                <div class="img-round aspect-[4/3] overflow-hidden">
                  <img src={s.image} alt="" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" style={`object-position:${s.pos}`} />
                </div>
                <div class="flex flex-1 flex-col px-3 pb-3 pt-6">
                  <p class="text-[11px] font-semibold uppercase tracking-[.22em] text-blue">{s.kicker}</p>
                  <h3 class="mt-2 text-2xl text-ink">{s.title}</h3>
                  <p class="mt-3 font-medium leading-relaxed text-ink/80">{s.summary}</p>
                  <p class="mt-2 flex-1 leading-relaxed">{s.body}</p>
                  <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-ink transition group-hover:text-blue">
                    Learn more
                    <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </a>
            </Reveal>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <Insurances />
  <WhyChooseUs />
</PageLayout>
