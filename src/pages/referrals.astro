---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import HoursList from '../components/islands/HoursList';
import { site, addressOneLine } from '../data/site';
const base = Astro.site;
const crumbSchema = (name: string, path: string) => ({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', base).toString() },
  { '@type': 'ListItem', position: 2, name, item: new URL(path, base).toString() } ] });
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(addressOneLine)}&output=embed`;
const dirHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(addressOneLine)}`;
const schema = [{ '@context': 'https://schema.org', '@type': 'WebPage', name: 'Referrals', url: new URL('/referrals', base).toString() }, crumbSchema('Referrals', '/referrals')];
const steps = [
  ['Download the form', 'Use the Referral Form below. Fill in the patient details and the reason for referral.'],
  ['Send it to us', 'Email it to our referral inbox or fax it to our office, along with recent notes, labs and imaging if you have them.'],
  ['We contact the patient', 'Our team reaches out to schedule a consultation and keeps you informed along the way.'],
];
const services = ['Gastric sleeve', 'Gastric bypass', 'Duodenal switch', 'Hernia repair', 'Gallbladder surgery', 'Acid reflux surgery', 'Robotic and minimally invasive surgery', 'Non-surgical weight loss'];
---
<PageLayout title="Referrals | Central California Surgery" description="Referring a patient to Dr. Huber at Central California Surgery in Modesto, CA? Download the referral form and send it by email or fax." schema={schema} bare>
  <PageHero title="Refer a Patient in Modesto, CA" eyebrow="For physicians" lede="Thank you for trusting us with your patients. Referring is simple, and we keep you in the loop." image="/images/stock/by-surgeons.jpg" imageAlt="Surgeons working together" position="50% 30%" crumbs={[{ label: 'Home', href: '/' }, { label: 'Referrals' }]} />
  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <p class="eyebrow">How it works</p>
      <ol class="mt-8 grid gap-5 md:grid-cols-3">
        {steps.map(([t, d], i) => <li class="card-hover border border-line bg-white p-7"><span class="grid h-9 w-9 place-items-center rounded-full bg-ink text-sm font-semibold text-white">{i + 1}</span><p class="mt-4 font-display text-xl text-ink">{t}</p><p class="mt-2 text-[15px] leading-relaxed">{d}</p></li>)}
      </ol>
    </div>
  </section>
  <section class="wash-mist py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 lg:grid-cols-2">
      <div class="border border-line bg-white p-8">
        <p class="eyebrow">Send a referral</p>
        <a href={site.referralPdf} target="_blank" rel="noopener" class="btn btn-solid mt-6">Download referral form (PDF)</a>
        <dl class="mt-8 space-y-4 text-[16px]">
          <div><dt class="text-xs font-semibold uppercase tracking-[.16em] text-slate">Email</dt><dd><a class="font-semibold text-ink hover:text-blue" href={`mailto:${site.referralEmail}`}>{site.referralEmail}</a></dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-[.16em] text-slate">Fax</dt><dd class="font-semibold text-ink">{site.fax}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-[.16em] text-slate">Phone</dt><dd><a class="font-semibold text-ink hover:text-blue" href={site.phoneHref}>{site.phone}</a></dd></div>
        </dl>
      </div>
      <div class="border border-line bg-white p-8">
        <p class="eyebrow">We accept referrals for</p>
        <ul class="mt-6 space-y-3">{services.map((s) => <li class="check-item flex gap-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-5 w-5 shrink-0 text-blue" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg><span>{s}</span></li>)}</ul>
      </div>
    </div>
  </section>
  <section class="wash-navy relative overflow-hidden py-14 text-center text-white">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-3xl !text-white md:text-4xl">Questions about a referral?</h2>
      <p class="mt-3 text-white/80">Call our team and we will help.</p>
      <a href={site.phoneHref} class="btn btn-appt-light mt-6">Call {site.phone}</a>
    </div>
  </section>
</PageLayout>
