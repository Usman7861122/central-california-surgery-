---
import PageLayout from '../../layouts/PageLayout.astro';
import PatientInfoPage from '../../components/sections/PatientInfoPage.astro';
import { patientPages } from '../../data/patientInfo';

export function getStaticPaths() {
  return patientPages.filter((p) => p.slug !== 'minimally-invasive-surgery').map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}
const { page } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const faq = page.blocks.find((b) => b.type === 'faq');
const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Patient Info', item: url },
      { '@type': 'ListItem', position: 3, name: page.title, item: url },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: page.title, url, description: page.metaDescription },
];
if (faq && faq.type === 'faq') {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<PageLayout title={`${page.title} | Patient Info`} description={page.metaDescription} schema={schema} bare>
  <PatientInfoPage page={page} />
</PageLayout>
