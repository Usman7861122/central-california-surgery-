---
interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'outline-light' | 'white' | 'appt' | 'appt-light';
  class?: string;
  external?: boolean;
  arrow?: boolean;
}
const { href = '#', variant = 'solid', class: className = '', external = false, arrow = false } = Astro.props;
const map = {
  solid: 'btn btn-solid',
  outline: 'btn btn-outline',
  'outline-light': 'btn btn-outline-light',
  white: 'btn btn-white',
  appt: 'btn btn-appt',
  'appt-light': 'btn btn-appt on-dark',
} as const;
---
<a href={href} class={`${map[variant]} ${className}`} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
  <slot />
  {arrow && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>)}
</a>
