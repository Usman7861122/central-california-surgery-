---
import SectionHead from '../ui/SectionHead.astro';
import ContactForm from '../islands/ContactForm';
import { site, addressOneLine } from '../../data/site';
const map = `https://www.google.com/maps?q=${encodeURIComponent(addressOneLine)}&output=embed`;
---
<section id="contact" class="wash-mist relative overflow-hidden py-20 md:py-28" aria-labelledby="contact-title">
  <div class="rings pointer-events-none absolute inset-0" style="--rx:100%;--ry:100%"></div>
  <div class="relative mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
    <div>
      <SectionHead id="contact-title" eyebrow="Get in touch" title="Let's talk about <em class='italic'>your health.</em>" text="Call, text or send a message. A member of our team will get back to you." />
      <ul class="mt-10 space-y-6">
        <li class="flex gap-4"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-[12px] border border-line bg-white text-blue"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg></span>
          <div><p class="text-xs font-semibold uppercase tracking-[.18em] text-ink">Call or text</p><a href={site.phoneHref} class="mt-1 block font-display text-2xl text-ink hover:text-blue">{site.phone}</a></div></li>
        <li class="flex gap-4"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-[12px] border border-line bg-white text-blue"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
          <div><p class="text-xs font-semibold uppercase tracking-[.18em] text-ink">Visit</p><p class="mt-1 text-lg text-ink">{site.address.line1}<br />{site.address.city}, {site.address.state} {site.address.zip}</p></div></li>
      </ul>
      <div class="img-round img-ring mt-10 aspect-[16/10]">
        <iframe title="Map to Central California Surgery" src={map} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="h-full w-full border-0 grayscale-[.35]"></iframe>
      </div>
    </div>
    <ContactForm client:visible endpoint={import.meta.env.PUBLIC_FORM_ENDPOINT ?? ''} />
  </div>
</section>
