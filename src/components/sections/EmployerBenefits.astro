---
import SectionHead from '../ui/SectionHead.astro';
import { partners } from '../../data/partners';
import { site } from '../../data/site';
const l = partners.lantern, b = partners.barinet;
---
<section id="employer-benefits" class="bg-white py-20 md:py-24" aria-labelledby="employer-title">
  <div class="mx-auto max-w-7xl px-6">
    <SectionHead id="employer-title" align="center" eyebrow="Employer benefits" title="Your employer may pay for your surgery." text="We work with Lantern and BARInet, two programs that help employers cover weight loss surgery." />
    <div class="mt-12 grid gap-6 lg:grid-cols-5">
      <a href="/lantern" class="group relative flex flex-col justify-between overflow-hidden bg-ink p-8 text-white transition hover:!bg-navy lg:col-span-3 md:p-10">
        <div>
          <span class="inline-block border border-white/30 px-3 py-1 text-xs font-semibold uppercase tracking-[.16em] text-blue-soft">Formerly SurgeryPlus</span>
          <h3 class="mt-5 font-display text-3xl !text-white md:text-4xl">Lantern</h3>
          <p class="mt-4 max-w-xl text-[17px] leading-relaxed text-white/80">A surgery benefit from your employer. Little to no out-of-pocket cost for eligible procedures, and a Care Advocate to guide you.</p>
          <ul class="mt-6 space-y-2 text-white/85">
            {['No extra cost to join', 'Dr. Huber is in network', 'We help you start'].map((t) => <li class="check-item-dark flex gap-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-5 w-5 shrink-0 text-blue-soft" aria-hidden="true"><path d="M5 12.5 9.5 17 19 7.5"/></svg><span>{t}</span></li>)}
          </ul>
        </div>
        <span class="mt-8 inline-flex items-center gap-2 font-semibold text-blue-soft">See how Lantern works <span aria-hidden="true" class="transition group-hover:translate-x-1">&rarr;</span></span>
      </a>
      <a href="/barinet" class="card-hover group flex flex-col justify-between border border-line bg-mist p-8 lg:col-span-2">
        <div>
          <span class="inline-block border border-line px-3 py-1 text-xs font-semibold uppercase tracking-[.16em] text-slate">National network</span>
          <h3 class="mt-5 font-display text-3xl text-ink">BARInet</h3>
          <p class="mt-4 text-[16px] leading-relaxed">If your plan uses BARInet for weight loss surgery, you can choose Dr. Huber and stay close to home.</p>
        </div>
        <span class="mt-8 inline-flex items-center gap-2 font-semibold text-blue">See how BARInet works <span aria-hidden="true" class="transition group-hover:translate-x-1">&rarr;</span></span>
      </a>
    </div>
    <p class="mt-8 text-center text-sm">Not sure if you have one of these benefits? <a class="link-u" href={site.phoneHref}>Call {site.phone}</a> and we will check for you.</p>
</div></section>
