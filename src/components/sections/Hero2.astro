---
import Button from '../ui/Button.astro';
import RotatingWords from '../islands/RotatingWords';
import HeroSlides from '../islands/HeroSlides';
import { site } from '../../data/site';
---
<section class="relative isolate flex min-h-[calc(100svh-7rem)] flex-col overflow-hidden bg-ink text-white" aria-labelledby="hero-title">
  <HeroSlides client:load slides={[
    { src: '/images/photos/ccs-3.jpg', alt: 'Dr. Andy Huber talking with a patient in front of anatomy charts', pos: '30% 30%' },
    { src: '/images/photos/ccs-2.jpg', alt: 'Dr. Andy Huber pointing to a weight loss surgery chart', pos: '34% 30%' },
    { src: '/images/photos/ccs-6.jpg', alt: 'Dr. Andy Huber smiling in the Central California Surgery lobby', pos: '26% 40%' },
  ]} />
  <!-- readability layers -->
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(95deg,#081a35_0%,rgba(8,26,53,.94)_32%,rgba(8,26,53,.45)_58%,rgba(8,26,53,.05)_100%)] max-md:bg-ink/70"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-gradient-to-t from-ink/85 to-transparent"></div>

  <div class="mx-auto flex w-full max-w-7xl flex-1 items-center px-6 py-16 md:py-20">
    <div class="max-w-4xl">
      <p class="eyebrow eyebrow-light">Bariatric &amp; General Surgery &middot; Modesto, California</p>
      <h1 id="hero-title" class="mt-6 text-[2.6rem] leading-[1.22] !text-white sm:text-6xl lg:text-[4.4rem]">
        Expert surgical care
        <br class="hidden sm:block" />
        to help you
        <RotatingWords client:load words={['feel lighter.', 'move freely.', 'live fully.']} />
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-white/85 md:text-xl">
        Board-certified surgeons serving Modesto, Stockton and Fresno. From your first seminar to long-term follow-up, our team is with you at every step.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/appointment" variant="appt-light" arrow>Book an appointment</Button>
        <Button href="/#bmi" variant="outline-light">Check your BMI</Button>
      </div>
    </div>
  </div>

  <!-- trust bar -->
  <div class="relative border-t border-white/15 bg-ink/55 backdrop-blur-md">
    <ul class="mx-auto grid max-w-7xl divide-white/15 px-6 text-sm sm:grid-cols-3 sm:divide-x">
      <li class="group relative flex cursor-default items-center gap-3 overflow-hidden py-4 transition-colors duration-300 hover:bg-white/[.07] sm:px-6">
        <span class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-center scale-x-0 bg-gradient-to-r from-transparent via-blue-soft to-transparent transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true"></span>
        <svg class="h-6 w-6 shrink-0 text-blue-soft transition duration-500 ease-out group-hover:scale-125 group-hover:text-white group-hover:drop-shadow-[0_0_10px_rgba(141,184,255,.9)] group-hover:rotate-[72deg]" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.8 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 16.8 6.6 19.7l1-6.1L3.2 9.3l6.1-.9L12 2.8Z"/></svg>
        <span><strong class="text-white">{site.rating.score} / 5</strong> from {site.rating.count} patient reviews</span>
      </li>
      <li class="group relative flex cursor-default items-center gap-3 overflow-hidden py-4 transition-colors duration-300 hover:bg-white/[.07] sm:px-6">
        <span class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-center scale-x-0 bg-gradient-to-r from-transparent via-blue-soft to-transparent transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true"></span>
        <svg class="h-6 w-6 shrink-0 text-blue-soft transition duration-500 ease-out group-hover:scale-125 group-hover:text-white group-hover:drop-shadow-[0_0_10px_rgba(141,184,255,.9)] group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3 4 6v6c0 4.5 3.4 7.8 8 9 4.6-1.2 8-4.5 8-9V6l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
        <span><strong class="text-white">Board-certified</strong> general &amp; bariatric surgeons</span>
      </li>
      <li class="group relative flex cursor-default items-center gap-3 overflow-hidden py-4 transition-colors duration-300 hover:bg-white/[.07] sm:px-6">
        <span class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-center scale-x-0 bg-gradient-to-r from-transparent via-blue-soft to-transparent transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true"></span>
        <svg class="h-6 w-6 shrink-0 text-blue-soft transition duration-500 ease-out group-hover:scale-125 group-hover:text-white group-hover:drop-shadow-[0_0_10px_rgba(141,184,255,.9)] group-hover:-rotate-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h3"/></svg>
        <span><strong class="text-white">Most major insurances</strong> accepted</span>
      </li>
    </ul>
  </div>
</section>
