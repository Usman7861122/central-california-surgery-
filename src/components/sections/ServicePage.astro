---
import PageHero from './PageHero.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import Reveal from '../islands/motion/Reveal';
import { site } from '../../data/site';
import { services } from '../../data/services';
import type { ServiceContent } from '../../data/serviceContent';

interface Props { slug: string; c: ServiceContent; }
const { slug, c } = Astro.props;
const [heroPhoto, candPhoto, mealPhoto] = c.photos;
const others = services.filter((s) => s.slug !== slug);
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 shrink-0 text-blue-soft" aria-hidden="true"><path d="m5 12.500 4.500 4.500L19 7.500"/></svg>';
---
<PageHero
  title={c.title}
  eyebrow={c.eyebrow}
  lede={c.lede}
  areaNote={c.areaNote}
  image={heroPhoto.src}
  imageAlt={heroPhoto.alt}
  position={heroPhoto.pos}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/#services' }, { label: c.title.replace(' in Modesto, CA', '') }]}
/>

<!-- 1. Overview -->
<section class="wash-mist relative overflow-hidden py-20 md:py-28" aria-labelledby="what-is">
  <div class="rings-light pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
    <Reveal client:visible>
      <SectionHead id="what-is" eyebrow={c.whatIs.eyebrow ?? "The procedure"} title={c.whatIs.title} />
      <div class="mt-6 space-y-5 text-lg leading-relaxed">
        {c.whatIs.text.map((t) => <p>{t}</p>)}
      </div>
      <div class="mt-9 flex flex-wrap gap-4">
        <Button href="/#contact" variant="solid" arrow>Book a consultation</Button>
        <Button href={site.phoneHref} variant="outline">Call {site.phone}</Button>
      </div>
    </Reveal>
    <Reveal client:visible delay={0.1}>
      <p class="eyebrow">How it works</p>
      <ol class="mt-5 space-y-4">
        {c.glance.map((g, i) => (
          <li class="card-hover flex gap-5 border border-line bg-white p-6">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink font-display text-lg text-white" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="font-display text-xl text-ink">{g.title}</h3>
              <p class="mt-1.5 leading-relaxed">{g.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </Reveal>
  </div>
</section>

<!-- 2. Is it right for you -->
<section class="wash-navy relative overflow-hidden py-20 text-white md:py-28" aria-labelledby="right-for-you">
  <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-6 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <Reveal client:visible>
      <img src={candPhoto.src} alt={candPhoto.alt} loading="lazy" class="img-round img-ring aspect-[4/3] w-full object-cover" style={`object-position:${candPhoto.pos ?? '50% 50%'}`} />
    </Reveal>
    <Reveal client:visible delay={0.1}>
      <SectionHead id="right-for-you" eyebrow="Is it for you?" title={c.candidates.title} text={c.candidates.text} light />
      <div class="mt-9 grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="font-sans text-xs font-semibold uppercase tracking-[.18em] text-blue-soft">{c.candidates.oftenLabel ?? "Often considered when there is"}</h3>
          <ul class="mt-4 space-y-3">{c.candidates.often.map((t) => <li class="flex gap-3 text-white/90"><Fragment set:html={check} />{t}</li>)}</ul>
        </div>
        <div>
          <h3 class="font-sans text-xs font-semibold uppercase tracking-[.18em] text-blue-soft">{c.candidates.mayLabel ?? "Health issues that may improve"}</h3>
          <ul class="mt-4 space-y-3">{c.candidates.may.map((t) => <li class="flex gap-3 text-white/90"><Fragment set:html={check} />{t}</li>)}</ul>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<!-- 3. Local -->
<section class="bg-white py-16 md:py-20" aria-labelledby="local-title">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
    <Reveal client:visible>
      <SectionHead id="local-title" eyebrow="Serving the Central Valley" title={c.local.title} />
      <div class="mt-5 space-y-4 text-lg leading-relaxed">{c.local.text.map((t) => <p>{t}</p>)}</div>
    </Reveal>
    <Reveal client:visible delay={0.1}>
      <p class="eyebrow">Patients visit us from</p>
      <ul class="mt-5 flex flex-wrap gap-2.5">
        {c.local.areas.map((a) => <li class="rounded-full border border-line bg-mist px-4 py-2 text-[15px] font-medium text-ink">{a}</li>)}
      </ul>
    </Reveal>
  </div>
</section>

<!-- 4. Benefits -->
<section class="wash-mist relative overflow-hidden py-20 md:py-28" aria-labelledby="benefits-title">
  <div class="relative mx-auto max-w-7xl px-6">
    <Reveal client:visible>
      <SectionHead id="benefits-title" eyebrow="Benefits" title={c.benefits.title} text={c.benefits.text} />
    </Reveal>
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {c.benefits.items.map((b) => (
        <li class="card-hover border border-line bg-white p-7">
          <span class="block h-px w-10 bg-blue"></span>
          <h3 class="mt-5 font-display text-xl text-ink">{b.title}</h3>
          <p class="mt-3 leading-relaxed">{b.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 5. Recovery -->
<section class="relative overflow-hidden bg-white py-20 md:py-28" aria-labelledby="recovery-title">
  <div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <Reveal client:visible>
      <SectionHead id="recovery-title" eyebrow="After surgery" title={c.recovery.title} text={c.recovery.text} />
      <img src={mealPhoto.src} alt={mealPhoto.alt} loading="lazy" class="img-round mt-9 aspect-[16/10] w-full object-cover" style={`object-position:${mealPhoto.pos ?? '50% 50%'}`} />
    </Reveal>
    <ol class="relative flex flex-col gap-12 border-l border-line pl-10">
      {c.recovery.steps.map((s) => (
        <Reveal client:visible as="li" className="group relative">
          <span class="absolute -left-[3.625rem] top-0 grid h-9 w-9 place-items-center" aria-hidden="true">
            <span class="absolute inset-0 rounded-full ring-2 ring-blue/60 opacity-0 group-hover:animate-ping group-hover:opacity-100"></span>
            <img src="/images/Logo.png" alt="" width="36" height="36" class="relative h-9 w-9 rounded-full bg-white shadow-[0_0_0_4px_#fff] ring-1 ring-line transition duration-700 ease-out group-hover:rotate-[360deg] group-hover:scale-125 group-hover:shadow-[0_0_0_4px_#fff,0_8px_20px_-4px_rgba(0,97,253,.55)]" />
          </span>
          <p class="eyebrow">{s.label}</p>
          <h3 class="mt-2 font-display text-2xl text-ink">{s.title}</h3>
          <p class="mt-2 leading-relaxed">{s.text}</p>
        </Reveal>
      ))}
    </ol>
  </div>
</section>

<!-- 6. Safety + FAQ -->
<section class="wash-mist relative overflow-hidden py-20 md:py-28" aria-labelledby="faq-title">
  <div class="mx-auto grid max-w-7xl gap-14 px-6 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
    <Reveal client:visible>
      <SectionHead eyebrow="Be informed" title={c.safety.title} />
      <div class="mt-6 space-y-4 leading-relaxed">{c.safety.text.map((t) => <p>{t}</p>)}</div>
      <p class="mt-6 text-xs leading-relaxed text-slate">This page is general information, not medical advice. Dr. Huber will review your own health history at your consultation.</p>
    </Reveal>
    <div>
      <h2 id="faq-title" class="text-3xl md:text-4xl">Common questions</h2>
      <div class="mt-7 divide-y divide-line border-y border-line">
        {c.faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-blue transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 max-w-prose leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- 7. Other services -->
<section class="bg-white py-20 md:py-24" aria-labelledby="other-title">
  <div class="mx-auto max-w-7xl px-6">
    <Reveal client:visible className="flex flex-wrap items-end justify-between gap-6">
      <SectionHead id="other-title" eyebrow="Explore more" title="Other services" />
      <Button href="/#services" variant="outline">All services</Button>
    </Reveal>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {others.map((s) => (
        <li class="card-hover border border-line bg-white">
          <a href={`/services/${s.slug}`} class="group block p-3">
            <img src={s.image} alt="" loading="lazy" class="img-round aspect-[4/3] w-full object-cover" style={`object-position:${s.pos}`} />
            <span class="mt-4 block px-1 font-display text-lg text-ink">{s.title}</span>
            <span class="mb-2 mt-1 block px-1 text-[13px] text-slate">{s.kicker}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
