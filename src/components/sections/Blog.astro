---
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { posts } from '../../data/blog';
---
<section id="blog" class="wash-light relative overflow-hidden py-20 md:py-28" aria-labelledby="blog-title">
  <div class="rings pointer-events-none absolute inset-0" style="--rx:0%;--ry:0%"></div>
  <div class="relative mx-auto max-w-7xl px-6">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <SectionHead id="blog-title" eyebrow="From the blog" title="Honest advice for <em class='italic'>every stage</em> of your journey." />
      <Button href="/blog" variant="outline" arrow>All articles</Button>
    </div>
    <ul class="mt-14 grid gap-8 md:grid-cols-3">
      {posts.map((p) => (
        <li>
          <a href={p.href} class="group block">
            <div class="img-round relative aspect-[4/3]">
              <img src={p.image} alt="" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
              <span class="absolute left-4 top-4 rounded-md bg-white/92 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[.18em] text-ink backdrop-blur">{p.tag}</span>
            </div>
            <h3 class="mt-6 text-2xl leading-snug text-ink transition group-hover:text-blue">{p.title}</h3>
            <p class="mt-3 leading-relaxed">{p.excerpt}</p>
            <span class="link-u mt-5 inline-block text-sm">Read article</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
