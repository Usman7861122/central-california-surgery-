---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from './PageHero.astro';
import { site } from '../../data/site';
import type { Partner } from '../../data/partners';
interface Props { p: Partner }
const { p } = Astro.props;
const base = Astro.site;
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: p.metaTitle, url: new URL(`/${p.slug}`, base).toString() },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', base).toString() },
    { '@type': 'ListItem', position: 2, name: p.name, item: new URL(`/${p.slug}`, base).toString() } ] },
];
const check = 'M5 12.5 9.5 17 19 7.5';
---
<PageLayout title={p.metaTitle} description={p.description} schema={schema} bare>
  <PageHero title={p.title} eyebrow={p.eyebrow} lede={p.lede} image={p.image} imageAlt={p.imageAlt} position="50% 30%" crumbs={[{ label: 'Home', href: '/' }, { label: p.name }]} />

  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 lg:grid-cols-[1fr_320px]">
      <div>
        <p class="eyebrow">About the benefit</p>
        <h2 class="mt-3 text-3xl text-ink md:text-4xl">{p.intro.title}</h2>
        {p.intro.text.map((t) => <p class="mt-4 text-[17px] leading-relaxed">{t}</p>)}
      </div>
      <div class="flex h-44 items-center justify-center border border-line bg-mist p-6">
        <img src={p.logo} alt={`${p.name} logo`} class="max-h-24 w-auto object-contain"
          onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'font-display text-4xl text-ink',textContent:this.alt.replace(' logo','')}))" />
      </div>
    </div>
  </section>

  <section class="wash-mist py-14 md:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-3 text-3xl text-ink md:text-4xl">Four simple steps</h2>
      <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {p.steps.map((s, i) => (
          <li class="card-hover border border-line bg-white p-7">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-ink text-sm font-semibold text-white">{i + 1}</span>
            <p class="mt-4 font-display text-xl text-ink">{s.title}</p>
            <p class="mt-2 text-[15px] leading-relaxed">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 lg:grid-cols-2">
      <div class="border border-line bg-white p-8">
        <p class="eyebrow">Coverage</p>
        <h2 class="mt-3 text-2xl text-ink md:text-3xl">{p.covered.title}</h2>
        <p class="mt-4 text-[16px] leading-relaxed">{p.covered.text}</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {['Gastric sleeve', 'Gastric bypass', 'Duodenal switch', 'Revision surgery'].map((s) => (
            <li class="check-item flex gap-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-5 w-5 shrink-0 text-blue" aria-hidden="true"><path d={check}/></svg><span>{s}</span></li>
          ))}
        </ul>
      </div>
      <div class="border border-line bg-sky p-8">
        <p class="eyebrow">Cost</p>
        <h2 class="mt-3 text-2xl text-ink md:text-3xl">{p.cost.title}</h2>
        <p class="mt-4 text-[16px] leading-relaxed">{p.cost.text}</p>
        <p class="mt-5 text-xs font-semibold uppercase tracking-[.16em] text-slate">Eligible plans often include</p>
        <ul class="mt-3 space-y-2.5">
          {p.cost.items.map((s) => (
            <li class="check-item flex gap-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-5 w-5 shrink-0 text-blue" aria-hidden="true"><path d={check}/></svg><span>{s}</span></li>
          ))}
        </ul>
        <p class="mt-5 text-sm leading-relaxed text-slate">{p.cost.note}</p>
      </div>
    </div>
  </section>

  <section class="wash-mist py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="eyebrow">Questions</p>
      <h2 class="mt-3 text-3xl text-ink md:text-4xl">Common questions about {p.name}</h2>
      <div class="mt-8 divide-y divide-line border border-line bg-white">
        {p.faqs.map((f) => (
          <details class="group p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg text-ink">{f.q}<span class="text-blue transition group-open:rotate-45" aria-hidden="true">+</span></summary>
            <p class="mt-3 text-[16px] leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-8 text-[15px]">{p.other.text} <a href={p.other.href} class="link-u font-semibold">Learn about {p.other.name}</a>.</p>
    </div>
  </section>

  <section class="wash-navy relative overflow-hidden py-14 text-center text-white">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-3xl !text-white md:text-4xl">Ready to see if {p.name} works for you?</h2>
      <p class="mt-3 text-white/80">Call our office and say you have {p.name}. We will check your benefit and book your visit.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href={site.phoneHref} class="btn btn-appt-light">Call {site.phone}</a>
        <a href={`/appointment?pay=${p.slug}`} class="btn btn-outline-light">Book appointment</a>
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-xs leading-relaxed text-white/60">{p.name} is a separate company and is not owned by Central California Surgery. Benefits, coverage and costs depend on your employer and plan. This page is not a promise of coverage or payment.</p>
    </div>
  </section>
</PageLayout>
