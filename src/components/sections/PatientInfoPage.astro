---
import PageHero from './PageHero.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import Reveal from '../islands/motion/Reveal';
import BmiCalculator from '../islands/BmiCalculator';
import { site } from '../../data/site';
import { patientPages } from '../../data/patientInfo';
import type { PatientPage } from '../../data/patientInfo';

interface Props { page: PatientPage; siblings?: { title: string; href: string }[]; moreEyebrow?: string; }
const { page, siblings, moreEyebrow } = Astro.props;
const others = siblings ?? patientPages.filter((p) => p.slug !== page.slug).map((p) => ({ title: p.title, href: `/patient-info/${p.slug}` }));
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 shrink-0 text-blue" aria-hidden="true"><path d="m5 12.500 4.500 4.500L19 7.500"/></svg>';
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const tone = (i: number) => (i % 2 === 0 ? 'wash-mist' : 'bg-white');
---
<PageHero
  title={page.title}
  eyebrow={page.eyebrow}
  lede={page.lede}
  image={page.image}
  imageAlt={page.alt}
  position={page.pos}
  crumbs={[{ label: 'Home', href: '/' }, { label: page.crumb ?? 'Patient Info' }, { label: page.title }]}
/>

{page.blocks.map((b, i) => {
  if (b.type === 'bmi') return (
    <section class="wash-navy relative overflow-hidden py-20 md:py-28" aria-labelledby="bmi-title">
      <div class="rings rings-light pointer-events-none absolute inset-0" style="--rx:0%;--ry:0%"></div>
      <div class="relative mx-auto max-w-6xl px-6">
        <SectionHead id="bmi-title" light align="center" eyebrow="BMI calculator" title="Know your starting point." text="Enter your height and weight to see your body mass index in seconds." />
        <div class="mt-14"><BmiCalculator client:visible /></div>
      </div>
    </section>
  );
  return (
    <section class={`${tone(i)} relative overflow-hidden ${'tight' in b && b.tight ? 'py-10 md:py-14' : 'py-16 md:py-24'}`}>
      <div class={`mx-auto px-6 max-w-5xl`}>
        <Reveal client:visible>
          <SectionHead eyebrow={b.eyebrow} title={b.title} text={'text' in b && typeof b.text === 'string' ? b.text : undefined} />

          {b.type === 'prose' && (
            <div class={`mt-7 ${b.image ? 'grid items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14' : ''}`}>
              <div class="max-w-3xl space-y-5 text-lg leading-relaxed">
                {b.text.map((t) => <p>{t}</p>)}
                {b.links && <div class="flex flex-wrap gap-4 pt-3">{b.links.map((l) => <Button href={l.href} variant="outline" arrow external={l.external}>{l.label}</Button>)}</div>}
              </div>
              {b.image && <img src={b.image.src} alt={b.image.alt} loading="lazy" class="img-round img-ring aspect-[4/3] w-full object-cover" style={`object-position:${b.image.pos ?? '50% 50%'}`} />}
            </div>
          )}

          {b.type === 'steps' && (
            <ol class="mt-10 grid gap-4 md:grid-cols-2">
              {b.items.map((s, n) => (
                <li class="card-hover flex gap-5 border border-line bg-white p-6">
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink font-display text-lg text-white" aria-hidden="true">{n + 1}</span>
                  <div>
                    <h3 class="font-display text-xl text-ink">{s.title}</h3>
                    {s.text && <p class="mt-1.5 leading-relaxed">{s.text}</p>}
                  </div>
                </li>
              ))}
            </ol>
          )}

          {b.type === 'checklists' && (
            <>
              <div class="mt-10 grid gap-6 md:grid-cols-2">
                {b.groups.map((g, gi) => (
                  <div class={`border border-line bg-white p-7 ${b.groups.length % 2 === 1 && gi === 0 && b.groups[0].items.length > 12 ? 'md:col-span-2' : ''}`}>
                    <h3 class="font-display text-2xl text-ink">{g.title}</h3>
                    <ul class={`mt-5 space-y-3 ${g.items.length > 12 ? 'md:columns-2 md:gap-10 [&>li]:break-inside-avoid' : ''}`}>
                      {g.items.map((t) => <li class="check-item flex gap-3 leading-relaxed mb-3"><Fragment set:html={check} />{t}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
              {b.note && <p class="mt-8 max-w-3xl border-l-2 border-blue pl-5 leading-relaxed text-slate">{b.note}</p>}
            </>
          )}

          {b.type === 'cards' && (
            <div class={`mt-10 ${b.image ? 'grid items-start gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14' : ''}`}>
              {b.image && <img src={b.image.src} alt={b.image.alt} loading="lazy" class="img-round img-ring aspect-[4/3] w-full object-cover" style={`object-position:${b.image.pos ?? '50% 50%'}`} />}
              <div class={`grid gap-5 ${b.image ? '' : 'sm:grid-cols-2 lg:grid-cols-4'}`}>
                {b.items.map((c) => (
                  <div class="card-hover border border-line bg-white p-7">
                    <span class="block h-px w-9 bg-blue"></span>
                    <h3 class="mt-4 font-display text-xl text-ink">{c.title}</h3>
                    <p class="mt-2 leading-relaxed">{c.text}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {b.type === 'books' && (
            <div class="mt-8 grid items-stretch gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12">
              <div class="relative min-h-[260px] overflow-hidden img-round img-ring">
                <img src={b.image.src} alt={b.image.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover" style={`object-position:${b.image.pos ?? '50% 50%'}`} />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 to-transparent p-6 pt-16 text-white">
                  <p class="font-display text-2xl">{b.items.length} books worth your time</p>
                </div>
              </div>
              <ul class="grid gap-2.5">
                {b.items.map((bk) => (
                  <li class="book-row flex items-center gap-4 border border-line bg-white px-4 py-3">
                    <span class="book-spine grid h-11 w-9 shrink-0 place-items-center rounded-[3px] bg-navy text-blue-soft shadow-[inset_3px_0_0_rgba(141,184,255,.45)]" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M8 7h8"/></svg>
                    </span>
                    <span class="min-w-0">
                      <span class="block font-display text-[17px] leading-snug text-ink">{bk.title}</span>
                      <span class="block text-sm text-slate">by {bk.author}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {b.type === 'quotes' && (
            <div class="mt-10 columns-1 gap-6 md:columns-2">
              {b.items.map((q) => (
                <figure class="card-hover mb-6 break-inside-avoid border border-line bg-white p-7">
                  <div class="flex items-center justify-between">
                    <div class="flex gap-0.5 text-blue" aria-label={`${q.stars ?? 5} out of 5 stars`}>
                      {Array.from({ length: q.stars ?? 5 }).map(() => <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2 6.3 20.3l1.2-6.4L2.8 9.5l6.4-.8z"/></svg>)}
                    </div>
                    <span class="font-display text-5xl leading-none text-blue-soft" aria-hidden="true">&ldquo;</span>
                  </div>
                  <blockquote class="mt-3 leading-relaxed text-ink/90">{q.text}</blockquote>
                  <figcaption class="mt-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-line pt-4">
                    <span class="font-semibold text-ink">{q.name}</span>
                    {q.href ? <a href={q.href} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-blue underline-offset-4 hover:underline">{q.meta ?? 'Read on Google'} &rarr;</a> : q.meta && <span class="text-sm text-slate">{q.meta}</span>}
                  </figcaption>
                </figure>
              ))}
            </div>
          )}

          {b.type === 'recipes' && (
            <div class="mt-10 grid gap-6 sm:grid-cols-2">
              {b.items.map((r, ri) => (
                <article class="card-hover flex flex-col overflow-hidden border border-line bg-white">
                  <div class={`aspect-[4/3] w-full overflow-hidden ${r.image?.fit === 'contain' ? 'bg-white' : 'bg-mist'}`}>
                    {r.image && <img src={r.image.src} alt={r.image.alt} loading="lazy" class={`h-full w-full ${r.image.fit === 'contain' ? 'object-contain p-5' : 'object-cover'}`} style={`object-position:${r.image.pos ?? '50% 50%'}`} />}
                  </div>
                  <div class="flex flex-1 flex-col p-6">
                    <h3 class="font-display text-2xl text-ink">{r.title}</h3>
                    <p class="mt-2 leading-relaxed">{r.blurb}</p>
                    <dl class="mt-4 flex flex-wrap gap-2">
                      {r.meta.slice(0, 3).map((m) => (
                        <div class="rounded-full border border-line bg-mist px-3 py-1 text-[12.5px]"><dt class="inline font-semibold text-ink">{m.label}: </dt><dd class="inline">{m.value}</dd></div>
                      ))}
                    </dl>
                    <div class="mt-auto pt-6"><button type="button" data-recipe-open={`recipe-${ri}`} class="btn btn-solid w-full justify-center">View full recipe</button></div>
                  </div>
                </article>
              ))}
              {b.items.map((r, ri) => (
                <dialog id={`recipe-${ri}`} class="recipe-modal" aria-labelledby={`recipe-${ri}-t`}>
                  <div class="relative">
                    <button type="button" data-recipe-close class="absolute right-4 top-4 z-10 grid h-10 w-10 place-items-center rounded-full bg-white/95 text-xl text-ink shadow-md transition hover:bg-ink hover:text-white" aria-label="Close recipe">&times;</button>
                    {r.image && <div class={`h-44 w-full sm:h-56 ${r.image.fit === 'contain' ? 'bg-white' : 'bg-mist'}`}><img src={r.image.src} alt={r.image.alt} class={`h-full w-full ${r.image.fit === 'contain' ? 'object-contain p-4' : 'object-cover'}`} style={`object-position:${r.image.pos ?? '50% 50%'}`} /></div>}
                    <div class="p-6 sm:p-9">
                      <h3 id={`recipe-${ri}-t`} class="font-display text-3xl text-ink">{r.title}</h3>
                      <dl class="mt-4 flex flex-wrap gap-2">
                        {r.meta.map((m) => (
                          <div class="rounded-full border border-line bg-mist px-3 py-1 text-[12.5px]"><dt class="inline font-semibold text-ink">{m.label}: </dt><dd class="inline">{m.value}</dd></div>
                        ))}
                      </dl>
                      <div class="mt-7 border border-line bg-mist p-5">
                        {r.groups.map((g, gi) => (
                          <div class={gi > 0 ? 'mt-6' : ''}>
                            <h4 class="font-sans text-xs font-semibold uppercase tracking-[.16em] text-blue">{g.title ?? 'Ingredients'}</h4>
                            <ul class="mt-3 grid gap-x-8 gap-y-1 text-[15px] sm:grid-cols-2">{g.items.map((i) => <li class="check-item flex gap-3 leading-snug"><Fragment set:html={check} />{i}</li>)}</ul>
                          </div>
                        ))}
                      </div>
                      <h4 class="mt-7 font-sans text-xs font-semibold uppercase tracking-[.16em] text-blue">Directions</h4>
                      <ol class="mt-3 space-y-1 text-[15px] sm:text-base">{r.steps.map((st, n) => <li class="check-item step-item flex gap-4 leading-relaxed"><span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-ink text-xs font-semibold text-white">{n + 1}</span><span>{st}</span></li>)}</ol>
                      {(r.notes || r.source) && (
                        <div class="mt-7 border-l-2 border-blue pl-4 text-sm leading-relaxed text-slate">
                          {r.notes && r.notes.map((n) => <p class="mb-1.5">{n}</p>)}
                          {r.source && <p class="italic">{r.source}</p>}
                        </div>
                      )}
                    </div>
                  </div>
                </dialog>
              ))}
            </div>
          )}

          {b.type === 'table' && (
            <>
              <div class="mt-10 overflow-x-auto border border-line bg-white">
                <table class="w-full text-left text-[13px] sm:text-[15px]">
                  <thead class="bg-ink text-white">
                    <tr>{b.head.map((h) => <th scope="col" class="px-3 py-3 text-[10px] font-semibold uppercase tracking-[.1em] sm:px-5 sm:py-4 sm:text-xs sm:tracking-[.14em]">{h}</th>)}</tr>
                  </thead>
                  <tbody>
                    {b.rows.map((r) => (
                      <tr class="border-t border-line even:bg-mist">
                        {r.map((c, ci) => <td class={`px-3 py-3 sm:px-5 sm:py-4 ${ci === r.length - 1 ? 'font-semibold text-ink' : ''}`}>{c}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {b.note && <p class="mt-5 text-sm text-slate">{b.note}</p>}
            </>
          )}

          {b.type === 'faq' && (
            <div class="mt-10 divide-y divide-line border-y border-line">
              {b.items.map((f) => (
                <details class="group py-5">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-sans text-lg font-semibold text-ink">
                    {f.q}
                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-blue transition group-open:rotate-45" aria-hidden="true">+</span>
                  </summary>
                  <p class="mt-4 max-w-3xl leading-relaxed">{f.a}</p>
                  {f.links && (
                    <div class="mt-4 flex flex-wrap gap-3">
                      {f.links.map((l) => <Button href={l.href} variant="outline" external={l.external}>{l.label}</Button>)}
                    </div>
                  )}
                </details>
              ))}
            </div>
          )}

          {b.type === 'downloads' && (
            <div class="mt-10 grid gap-5 sm:grid-cols-2">
              {b.items.map((d) => (
                <a href={d.href} target="_blank" rel="noopener noreferrer" class="card-hover group flex items-center gap-5 border border-line bg-white p-7">
                  <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-sky text-blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 11v6m-3-3 3 3 3-3"/></svg>
                  </span>
                  <span>
                    <span class="block font-display text-xl text-ink">{d.title}</span>
                    <span class="mt-1 block text-sm uppercase tracking-[.14em] text-slate">{d.text} · opens in a new tab</span>
                  </span>
                </a>
              ))}
            </div>
          )}

          {b.type === 'videos' && (
            <div class={`mt-10 grid gap-8 ${b.items.length > 1 ? 'md:grid-cols-2' : 'mx-auto max-w-3xl'}`}>
              {b.items.map((v) => (
                <figure>
                  <div class="img-round overflow-hidden border border-line bg-ink shadow-sm">
                    <iframe class="aspect-video w-full" src={`https://www.youtube-nocookie.com/embed/${v.id}`} title={v.title} loading="lazy" allow="accelerometer; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
                  </div>
                  <figcaption class="mt-4 font-display text-xl text-ink">{v.title}</figcaption>
                </figure>
              ))}
            </div>
          )}

          {b.type === 'contact' && (
            <>
              {b.text && null}
              <dl class="mt-10 grid gap-4 sm:grid-cols-2">
                {b.items.map((c) => (
                  <div class="border border-line bg-white p-6">
                    <dt class="text-xs font-semibold uppercase tracking-[.16em] text-blue">{c.label}</dt>
                    <dd class="mt-2 break-all font-display text-lg text-ink sm:break-words sm:text-xl">{c.href ? <a href={c.href} class="transition hover:text-blue">{c.value}</a> : c.value}</dd>
                  </div>
                ))}
              </dl>
            </>
          )}

          {b.type === 'links' && (
            <div class={`grid gap-6 ${b.tight ? 'mt-6' : 'mt-10'} ${b.groups.length > 1 ? 'md:grid-cols-2' : ''}`}>
              {b.groups.map((g) => (
                <div>
                  <h3 class="font-sans text-xs font-semibold uppercase tracking-[.18em] text-blue">{g.title}</h3>
                  <ul class={`mt-3 grid gap-3 ${b.groups.length === 1 ? (g.items.length > 2 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2') : ''}`}>
                    {g.items.map((l) => (
                      <li>
                        <a href={l.href} target="_blank" rel="noopener noreferrer" class="card-hover flex h-full items-center justify-between gap-4 border border-line bg-white px-5 py-4 font-semibold text-ink">
                          <span>{l.label}{l.desc && <span class="mt-0.5 block text-sm font-normal text-slate">{l.desc}</span>}</span><Fragment set:html={arrow} />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </Reveal>
      </div>
    </section>
  );
})}

<section class="wash-navy relative overflow-hidden py-16 text-white md:py-20" aria-labelledby="pi-help">
  <div class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-8 px-6 md:flex-row md:items-center">
    <div class="max-w-xl">
      <p class="eyebrow eyebrow-light">We are here to help</p>
      <h2 id="pi-help" class="mt-4 text-3xl !text-white md:text-4xl">Have a question? Talk to our team.</h2>
      <p class="mt-3 text-white/75">Call or text {site.phone}, or book a consultation with Dr. Huber.</p>
    </div>
    <div class="flex flex-wrap gap-4">
      <Button href="/appointment" variant="appt-light">Book appointment</Button>
      <Button href={site.phoneHref} variant="outline-light">Call {site.phone}</Button>
    </div>
  </div>
</section>

{!page.hideMore && <section class="wash-mist py-16 md:py-20" aria-labelledby="more-info">
  <div class="mx-auto max-w-7xl px-6">
    <SectionHead id="more-info" eyebrow={moreEyebrow ?? "More patient info"} title="Keep exploring" />
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {others.map((p) => (
        <li>
          <a href={p.href} class="card-hover flex items-center justify-between gap-4 border border-line bg-white px-6 py-5">
            <span class="font-semibold text-ink">{p.title}</span>
            <Fragment set:html={arrow} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>}

<style is:global>
  .check-item { margin-left:-.75rem; margin-right:-.75rem; padding:.5rem .75rem; border-radius:.75rem; transition:transform .25s ease, background-color .25s ease, color .25s ease, box-shadow .25s ease; cursor:default; }
  .check-item svg { flex-shrink:0; transition:transform .25s ease; }
  .check-item:hover { transform:translateX(6px); background:#eaf2ff; color:#081a35; box-shadow:0 6px 18px -10px rgba(12,42,85,.35); }
  .check-item:hover svg { transform:scale(1.25); }
  @media (prefers-reduced-motion:reduce){ .check-item, .check-item svg { transition:none; } .check-item:hover { transform:none; } }
  .book-row { transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .book-row:hover { transform:translateX(6px); border-color:#8db8ff; box-shadow:0 10px 24px -14px rgba(12,42,85,.45); }
  .book-row:hover .book-spine { background:#0061fd; color:#fff; }
  .book-spine { transition:background-color .25s ease, color .25s ease; }
  @media (prefers-reduced-motion:reduce){ .book-row { transition:none; } .book-row:hover { transform:none; } }
  .step-item > span:first-child { transition:transform .25s ease, background-color .25s ease; }
  .step-item:hover > span:first-child { transform:scale(1.2); background:#0061fd; }
  dialog.recipe-modal { width:min(760px,calc(100vw - 24px)); max-height:90vh; margin:auto; padding:0; border:0; background:#fff; border-radius:14px; overflow-y:auto; box-shadow:0 30px 80px -20px rgba(8,26,53,.55); color:#4d5d77; }
  dialog.recipe-modal::backdrop { background:rgba(8,26,53,.62); backdrop-filter:blur(3px); }
  dialog.recipe-modal[open] { animation:rm-in .25s ease; }
  @keyframes rm-in { from { opacity:0; transform:translateY(12px) scale(.98); } to { opacity:1; transform:none; } }
  body:has(dialog.recipe-modal[open]) { overflow:hidden; }
</style>

<script>
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const open = t.closest('[data-recipe-open]') as HTMLElement | null;
    if (open) { (document.getElementById(open.dataset.recipeOpen!) as HTMLDialogElement)?.showModal(); return; }
    if (t.closest('[data-recipe-close]')) { (t.closest('dialog') as HTMLDialogElement)?.close(); return; }
    if (t instanceof HTMLDialogElement && t.classList.contains('recipe-modal')) t.close();
  });
</script>
