---
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
interface Props { title: string; eyebrow: string; lede: string; image: string; imageAlt: string; position?: string; crumbs: { label: string; href?: string }[]; areaNote?: string; }
const idx = (Astro.props.title as string).lastIndexOf(' in ');
const head = idx > 0 ? Astro.props.title.slice(0, idx + 4) : Astro.props.title;
const city = idx > 0 ? Astro.props.title.slice(idx + 4) : '';
const { title, eyebrow, lede, image, imageAlt, position = '50% 50%', crumbs, areaNote } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-ink text-white" aria-labelledby="page-title">
  <img src={image} alt={imageAlt} fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover" style={`object-position:${position}`} />
  <div class="absolute inset-0 -z-10" style="background:linear-gradient(90deg,rgba(8,26,53,.94) 0%,rgba(8,26,53,.82) 45%,rgba(8,26,53,.45) 100%)"></div>
  <div class="mx-auto max-w-7xl px-6 pb-20 pt-10 md:pb-28 md:pt-14">
    <nav aria-label="Breadcrumb" class="text-[13px] text-white/70">
      <ol class="flex flex-wrap items-center gap-2">
        {crumbs.map((c, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" class="text-white/40">/</span>}
            {c.href ? <a href={c.href} class="transition hover:text-white">{c.label}</a> : <span aria-current="page" class="text-white">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
    <div class="mt-12 max-w-2xl md:mt-16">
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h1 id="page-title" class="mt-5 text-4xl leading-[1.08] !text-white sm:text-5xl md:text-6xl">{head}{city && <span class="text-blue-soft">{city}</span>}</h1>
      <p class="mt-6 text-lg leading-relaxed text-white/80">{lede}</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <Button href="/#contact" variant="appt-light">Book appointment</Button>
        <Button href={site.phoneHref} variant="outline-light">Call {site.phone}</Button>
      </div>
    </div>
    {areaNote && (
      <div class="mt-14 border-t border-white/15 pt-7 md:mt-16">
        <p class="flex max-w-3xl items-start gap-4 text-[17px] font-light leading-relaxed text-white/75">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="mt-1 h-6 w-6 shrink-0 text-blue-soft" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          {areaNote}
        </p>
      </div>
    )}
  </div>
</section>
