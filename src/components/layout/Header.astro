---
import { mainNav } from '../../data/navigation';
import { site, addressOneLine } from '../../data/site';
import MegaNav from '../islands/MegaNav';
import MobileMenu from '../islands/MobileMenu';
import Button from '../ui/Button.astro';
---
<header class="sticky top-0 z-50">
  <!-- utility bar -->
  <div class="hidden bg-ink text-[13px] text-white/85 md:block">
    <div class="mx-auto flex h-10 max-w-[90rem] items-center justify-between px-6">
      <p class="flex items-center gap-2">
        <svg class="h-3.5 w-3.5 text-blue-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
        {addressOneLine}
      </p>
      <div class="flex items-center gap-6">
        <a href="/#products" class="transition hover:text-white">Shop vitamins</a>
        <a href={site.links.financing} target="_blank" rel="noopener" class="transition hover:text-white">Financing available</a>
        <a href={site.phoneHref} class="font-semibold text-white transition hover:text-blue-soft">{site.phone}</a>
      </div>
    </div>
  </div>

  <!-- main bar -->
  <div class="relative border-b border-line bg-white/92 backdrop-blur-md supports-[backdrop-filter]:bg-white/85">
    <div class="mx-auto flex h-[4.5rem] max-w-[90rem] items-center justify-between gap-5 px-6">
      <a href="/" class="flex items-center gap-3" aria-label={`${site.name} home`}>
        <img src="/images/Logo.png" alt="" width="56" height="56" class="h-14 w-14" />
        <span class="hidden whitespace-nowrap leading-tight sm:block">
          <span class="block font-display text-lg font-semibold text-ink">Central California</span>
          <span class="block text-[11px] font-semibold uppercase tracking-[.28em] text-slate">Surgery</span>
        </span>
      </a>

      <MegaNav client:load items={mainNav} />

      <div class="flex items-center gap-3">
        <Button href="/appointment" variant="appt" class="hidden sm:inline-flex !px-5 !py-3">Book appointment</Button>
        <MobileMenu client:load items={mainNav} phone={site.phone} phoneHref={site.phoneHref} />
      </div>
    </div>
  </div>
</header>
