---
import { site } from '../../data/site';
const { title, description = site.seo.description, schema = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.seo.title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ld = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'Physician'],
  name: site.name,
  url: site.url,
  telephone: site.phone,
  image: new URL(site.seo.ogImage, Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  areaServed: site.areas,
  medicalSpecialty: 'Surgery',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: site.rating.score, reviewCount: site.rating.count },
};
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(site.seo.ogImage, Astro.site)} />
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
{schema.map((x: object) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
