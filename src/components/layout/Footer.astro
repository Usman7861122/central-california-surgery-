---
import { footerNav } from '../../data/navigation';
import { site, addressOneLine } from '../../data/site';
---
<footer class="wash-navy relative overflow-hidden text-white/75">
  <div class="rings rings-light pointer-events-none absolute inset-0" style="--rx:0%;--ry:100%"></div>
  <div class="relative mx-auto max-w-7xl px-6 pb-8 pt-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <a href="/" class="flex items-center gap-3">
          <img src="/images/Logo.png" alt="" width="64" height="64" class="h-16 w-16" />
          <span class="font-display text-xl text-white">Central California Surgery</span>
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed">Board-certified bariatric and general surgeons caring for patients in Modesto, Stockton, Fresno and the Central Valley.</p>
      </div>
      {Object.entries(footerNav).map(([heading, links]) => (
        <nav aria-label={heading}>
          <h3 class="font-sans text-xs font-semibold uppercase tracking-[.22em] text-white">{heading}</h3>
          <ul class="mt-5 space-y-3 text-sm">
            {links.map((l) => (
              <li><a href={l.href} class="transition hover:text-white" {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
      <div>
        <h3 class="font-sans text-xs font-semibold uppercase tracking-[.22em] text-white">Visit us</h3>
        <address class="mt-5 space-y-3 text-sm not-italic">
          <p>{site.address.line1}<br />{site.address.city}, {site.address.state} {site.address.zip}</p>
          <p><a href={site.phoneHref} class="text-lg font-semibold text-white transition hover:text-blue-soft">{site.phone}</a></p>
          <p><a class="link-u !text-white" target="_blank" rel="noopener" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(addressOneLine)}`}>Get directions</a></p>
        </address>
      </div>
    </div>
    <div class="mt-14 flex flex-col gap-3 border-t border-white/15 pt-6 text-xs md:flex-row md:items-center md:justify-between">
      <p>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a class="hover:text-white" href={site.links.privacy}>Privacy</a></li>
        <li><a class="hover:text-white" href={site.links.terms}>Terms</a></li>
        <li><a class="hover:text-white" href={site.links.accessibility}>Accessibility</a></li>
        <li><a class="hover:text-white" href={site.links.cookies}>Cookie policy</a></li>
        <li><button type="button" data-cookie-settings class="hover:text-white">Cookie settings</button></li>
      </ul>
    </div>
  </div>
</footer>
